# Copy to paths.env (do not commit) and fill in.

# Writable tree for data, packed pools, runs, logs, and the HF cache.
CS_ROOT=/path/to/workdir

# Python environment with the packages in requirements.txt.
CS_ENV=/path/to/venv

# Optional: override the code root (defaults to this repository).
# CS_CODE=/path/to/this/repo

# Optional Slurm site settings. Omit to use the cluster default.
# SLURM_PARTITION=gpu
# SLURM_CPU_PARTITION=shared
# SLURM_ACCOUNT=myaccount

# Optional Hugging Face cache (defaults to $CS_ROOT/hf_cache).
# HF_HOME=$CS_ROOT/hf_cache

# fastText LID model used by SoloWeb cleaning.
# Download: https://dl.fbaipublicfiles.com/fasttext/supervised-models/lid.176.bin
# LID_MODEL=$CS_ROOT/resources/lid.176.bin

# NLTK data dir for Punkt (used by SoloWeb cleaning). See DATA.md.
# NLTK_DATA=$CS_ROOT/nltk_data

# Checkout of https://github.com/igorsterner/TongueSwitcher (generation tagging only).
# TONGUESWITCHER_SRC=/path/to/TongueSwitcher/src
# TONGUESWITCHER_ROOT=/path/to/TongueSwitcher

# Local data rebuilt after accepting third-party terms (see DATA.md).
# CLEAN_DIR=$CS_ROOT/data/fineweb_clean
# TOKENIZER_DIR=$CS_ROOT/data/sw_union_tokenizer
# MONO_HELDOUT=$CS_ROOT/data/soloweb_heldout
# TS_HELDOUT=$CS_ROOT/data/ts_heldout
# TONGUESWITCHER=$CS_ROOT/data/tongueswitcher_train_leakfree.jsonl
# DENGLISCH_VALID=$CS_ROOT/data/valid_denglisch_manual_cs.jsonl
# ACS_PAIRS=$CS_ROOT/data/acs_pairs.csv
